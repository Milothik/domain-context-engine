{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "decision-result",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "candidate",
      "selected",
      "reason",
      "materialEffects",
      "confidence"
    ],
    "properties": {
      "candidate": {
        "type": "string"
      },
      "selected": {
        "type": "boolean"
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "materialEffects": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "evidence": {}
    },
    "additionalProperties": false
  }
}
