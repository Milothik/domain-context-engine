{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "facts"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entityId",
          "value",
          "provenance"
        ],
        "properties": {
          "entityId": {
            "type": "string"
          },
          "value": {
            "type": "object"
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source",
                "type",
                "confidence"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "user-canon",
                    "inferred",
                    "generated",
                    "external",
                    "uncertain"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "locator": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "fieldProvenance": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "source",
                  "type",
                  "confidence"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "user-canon",
                      "inferred",
                      "generated",
                      "external",
                      "uncertain"
                    ]
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "locator": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
