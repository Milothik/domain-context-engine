{
  "name": "domain-context-engine",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Turn domain knowledge into generation-ready context.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/sync-schemas.mjs && tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node examples/run.mjs",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "benchmark:live": "npm run build && node benchmarks/live.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ]
}
